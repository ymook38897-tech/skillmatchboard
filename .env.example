# API Configuration
VITE_API_BASE_URL=http://localhost:3000

# Mock LLM Configuration (Development Only)
# Enable mock LLM processing for testing without backend connection
VITE_USE_MOCK_LLM=false

# Mock mode: 'success', 'error', 'timeout'
# - success: Simulates successful LLM processing
# - error: Simulates server error after delay
# - timeout: Simulates request timeout
VITE_MOCK_LLM_MODE=success

# Mock response delay in milliseconds
VITE_MOCK_LLM_DELAY_MS=1000
